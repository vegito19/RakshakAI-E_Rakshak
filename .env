PORT=5000

# Redis Configuration (decodes connection properties for standard Redis instance)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=rakshak_db
# Or use connection string:
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/rakshak_db

# Crawler Parameters
POST_LIMIT=10

# Target social groups to map Surat OSINT metrics
SUBREDDITS=surat,gujarat
TELEGRAM_CHANNELS=surat_news,gujarat_safety,indiatimes

# Proxy Settings
# Use this to bypass ISP blockages (e.g. on Telegram t.me web previews) or scraping limits.
# Supports SOCKS5, HTTP, and HTTPS proxies.
# Examples:
# PROXY_SERVER=socks5://127.0.0.1:9050
# PROXY_SERVER=http://username:password@proxy.example.com:8888
PROXY_SERVER=

# Logging level configuration (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# API Keys (required for Instagram Reels Scraper Pipeline)
